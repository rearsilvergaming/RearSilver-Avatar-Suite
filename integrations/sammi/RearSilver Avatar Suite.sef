[extension_name]
RearSilver Avatar Suite
[extension_info]
Connects SAMMI Bridge to RearSilver Avatar Suite through its local WebSocket server. Version 0.3.1. Author: RearSilver.
[extension_version]
0.3.1
[insert_external]
<style>
#rearsilver-avatar-suite-panel{--ras-bg:#0e151e;--ras-surface:#111821;--ras-raised:#17202c;--ras-border:#344257;--ras-text:#e6e8eb;--ras-muted:#9db0c7;--ras-cyan:#00d4ff;--ras-cyan-dark:#075166;box-sizing:border-box;margin:-12px;padding:24px;min-height:440px;border-radius:0 0 12px 12px;background:var(--ras-bg);color:var(--ras-text);font-family:Sora,"Segoe UI",sans-serif}
#rearsilver-avatar-suite-panel *{box-sizing:border-box}
#rearsilver-avatar-suite-panel .ras-header{display:flex;align-items:center;gap:14px;margin-bottom:22px}
#rearsilver-avatar-suite-panel .ras-mark{display:grid;place-items:center;width:50px;height:50px;flex:0 0 50px;border:1px solid var(--ras-cyan);border-radius:13px;background:#0b0f14;box-shadow:0 0 24px rgba(0,212,255,.16);overflow:hidden}
#rearsilver-avatar-suite-panel .ras-mark img{display:block;width:100%;height:100%;object-fit:cover}
#rearsilver-avatar-suite-panel h2{margin:0;color:#fff;font-size:21px;font-weight:800}
#rearsilver-avatar-suite-panel .ras-subtitle{margin:4px 0 0;color:var(--ras-muted);font-size:13px}
#rearsilver-avatar-suite-panel .ras-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:16px}
#rearsilver-avatar-suite-panel .ras-card{min-width:0;padding:20px;border:1px solid var(--ras-border);border-radius:12px;background:var(--ras-raised)}
#rearsilver-avatar-suite-panel .ras-card-heading{margin:0 0 16px;color:#fff;font-size:15px;font-weight:800}
#rearsilver-avatar-suite-panel .ras-connection{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px;border:1px solid var(--ras-border);border-radius:10px;background:var(--ras-surface)}
#rearsilver-avatar-suite-panel .ras-label{display:block;margin-bottom:6px;color:var(--ras-muted);font-size:11px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}
#rearsilver-avatar-suite-panel #rearsilver-avatar-suite-status{display:inline-flex;align-items:center;min-height:27px;padding:5px 10px;border-radius:999px;background:#093b48;color:var(--ras-cyan);font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}
#rearsilver-avatar-suite-panel #rearsilver-avatar-suite-status[data-state="waiting"]{background:#493c18;color:#ffd76a}
#rearsilver-avatar-suite-panel #rearsilver-avatar-suite-status[data-state="error"]{background:#4b2029;color:#ff8393}
#rearsilver-avatar-suite-panel #rearsilver-avatar-suite-catalogue{margin:15px 0;color:var(--ras-text);font-size:13px;line-height:1.6}
#rearsilver-avatar-suite-panel .ras-actions{display:flex;flex-wrap:wrap;gap:8px}
#rearsilver-avatar-suite-panel button{padding:9px 13px;border:1px solid var(--ras-border);border-radius:9px;background:#1e2430;color:var(--ras-text);font:700 12px Sora,"Segoe UI",sans-serif;cursor:pointer}
#rearsilver-avatar-suite-panel button:hover{border-color:var(--ras-cyan);background:#063847;color:#fff}
#rearsilver-avatar-suite-panel button.ras-primary{border-color:var(--ras-cyan);background:var(--ras-cyan-dark);color:#fff}
#rearsilver-avatar-suite-panel .ras-data{display:grid;gap:16px}
#rearsilver-avatar-suite-panel .ras-value{overflow-wrap:anywhere;color:var(--ras-text);font-size:13px;line-height:1.55}
#rearsilver-avatar-suite-panel samp{color:var(--ras-cyan);font:12px Consolas,monospace}
#rearsilver-avatar-suite-panel details{padding-top:14px;border-top:1px solid var(--ras-border)}
#rearsilver-avatar-suite-panel summary{color:var(--ras-muted);font-size:12px;font-weight:700;cursor:pointer}
#rearsilver-avatar-suite-panel details samp{display:block;max-height:170px;margin-top:10px;padding:12px;overflow:auto;border-radius:8px;background:#0b0f14;color:var(--ras-muted);white-space:pre-wrap}
#rearsilver-avatar-suite-panel .ras-note{margin:16px 0 0;color:var(--ras-muted);font-size:11px;line-height:1.5}
@media(max-width:850px){#rearsilver-avatar-suite-panel .ras-grid{grid-template-columns:1fr}}
</style>
<div id="rearsilver-avatar-suite-panel">
  <header class="ras-header">
    <div class="ras-mark"><img src="data:image/png;base64," alt="RearSilver Avatar Suite"></div>
    <div><h2>RearSilver Avatar Suite</h2><p class="ras-subtitle">Local automation integration for SAMMI</p></div>
  </header>
  <div class="ras-grid">
    <section class="ras-card">
      <h3 class="ras-card-heading">Connection</h3>
      <div class="ras-connection"><div><span class="ras-label">Local server</span><samp>ws://127.0.0.1:17891/</samp></div><strong id="rearsilver-avatar-suite-status">Starting…</strong></div>
      <div id="rearsilver-avatar-suite-catalogue">Waiting for catalogue…</div>
      <div class="ras-actions"><button type="button" class="ras-primary" id="rearsilver-avatar-suite-reconnect">Reconnect</button><button type="button" id="rearsilver-avatar-suite-refresh">Refresh catalogue</button><button type="button" id="rearsilver-avatar-suite-check">Check server</button></div>
      <p class="ras-note">Avatar Suite only accepts automation connections from this computer.</p>
    </section>
    <section class="ras-card ras-data">
      <div><span class="ras-label">Activity</span><div class="ras-value" id="rearsilver-avatar-suite-response">Waiting for Avatar Suite…</div></div>
      <details><summary>Diagnostics</summary><samp id="rearsilver-avatar-suite-diagnostics">No response received yet.</samp></details>
    </section>
  </div>
</div>
[insert_command]
RearSilverAvatarSuite.registerCommands();
[insert_hook]
case "RearSilver Avatar Suite: Check Server":
  RearSilverAvatarSuite.checkServer();
  break;
case "RearSilver Avatar Suite: Refresh Catalogue":
  RearSilverAvatarSuite.refreshCatalogue();
  break;
case "RearSilver Avatar Suite: Activate Preset":
  RearSilverAvatarSuite.activatePreset(SAMMIJSON.preset);
  break;
case "RearSilver Avatar Suite: Set Layer Visibility":
  RearSilverAvatarSuite.setVisibility("layer.visibility", SAMMIJSON.layer, SAMMIJSON.visibility);
  break;
case "RearSilver Avatar Suite: Set Group Visibility":
  RearSilverAvatarSuite.setVisibility("group.visibility", SAMMIJSON.group, SAMMIJSON.visibility);
  break;
case "RearSilver Avatar Suite: Set Configured Effect State":
  RearSilverAvatarSuite.setEffectState(SAMMIJSON.effect, SAMMIJSON.effectState);
  break;
case "RearSilver Avatar Suite: Run Sequence JSON":
  RearSilverAvatarSuite.runSequenceJson(SAMMIJSON.sequenceJson);
  break;
[insert_script]
var RearSilverAvatarSuite = (function () {
  "use strict";
  var endpoint = "ws://127.0.0.1:17891/", socket = null, reconnectTimer = null;
  var pendingMessages = [], catalogue = { presets: [], layers: [], groups: [], effects: [], savedActions: [] };
  var labels = { presets: {}, layers: {}, groups: {}, effects: {} };
  function element(id) { return document.getElementById(id); }
  function setStatus(text, colour) { var target = element("rearsilver-avatar-suite-status"); if (target) { target.textContent = text; target.setAttribute("data-state", colour === "#ff5c70" ? "error" : colour === "#f0ad4e" ? "waiting" : "connected"); } }
  function setResponse(text) { var target = element("rearsilver-avatar-suite-response"); if (target) target.textContent = text; }
  function setDiagnostics(text) { var target = element("rearsilver-avatar-suite-diagnostics"); if (target) target.textContent = text; }
  function setCatalogueSummary() {
    var target = element("rearsilver-avatar-suite-catalogue"); if (!target) return;
    var active = catalogue.activePreset && catalogue.activePreset.name ? catalogue.activePreset.name : "Unknown";
    target.textContent = "Active preset: " + active + " · " + catalogue.presets.length + " presets · " + catalogue.layers.length + " layers · " + catalogue.groups.length + " groups · " + catalogue.effects.length + " effects";
  }
  function uniqueLabels(items, makeLabel) {
    var counts = {}, map = {}, options = [];
    items.forEach(function (item) { var base = String(makeLabel(item) || item.id || "Unnamed"); counts[base] = (counts[base] || 0) + 1; var label = counts[base] === 1 ? base : base + " (" + counts[base] + ")"; map[label] = item; options.push(label); });
    return { map: map, options: options.length ? options : ["No items available"] };
  }
  function rebuildLabels() {
    var presetData = uniqueLabels(catalogue.presets, function (item) { return item.name; });
    var layerData = uniqueLabels(catalogue.layers, function (item) { return item.name; });
    var groupData = uniqueLabels(catalogue.groups, function (item) { return item.name; });
    var effectData = uniqueLabels(catalogue.effects, function (item) { return item.ownerName + " — " + item.name; });
    labels.presets = presetData.map; labels.layers = layerData.map; labels.groups = groupData.map; labels.effects = effectData.map;
    return { presets: presetData.options, layers: layerData.options, groups: groupData.options, effects: effectData.options };
  }
  function registerCommands() {
    var options = rebuildLabels();
    SAMMI.extCommand("RearSilver Avatar Suite: Check Server", 10921638, 52, {});
    SAMMI.extCommand("RearSilver Avatar Suite: Refresh Catalogue", 10921638, 52, {});
    SAMMI.extCommand("RearSilver Avatar Suite: Activate Preset", 10921638, 52, { preset: ["Preset", SAMMIVars.box_selectstring, options.presets[0], 1, options.presets] });
    SAMMI.extCommand("RearSilver Avatar Suite: Set Layer Visibility", 10921638, 52, { layer: ["Layer", SAMMIVars.box_selectstring, options.layers[0], 1, options.layers], visibility: ["Visibility", SAMMIVars.box_selectstring, "Show", 1, ["Show", "Hide"]] });
    SAMMI.extCommand("RearSilver Avatar Suite: Set Group Visibility", 10921638, 52, { group: ["Group", SAMMIVars.box_selectstring, options.groups[0], 1, options.groups], visibility: ["Visibility", SAMMIVars.box_selectstring, "Show", 1, ["Show", "Hide"]] });
    SAMMI.extCommand("RearSilver Avatar Suite: Set Configured Effect State", 10921638, 52, { effect: ["Configured effect", SAMMIVars.box_selectstring, options.effects[0], 1, options.effects], effectState: ["Effect state", SAMMIVars.box_selectstring, "Enable", 1, ["Enable", "Disable"]] });
    SAMMI.extCommand("RearSilver Avatar Suite: Run Sequence JSON", 10921638, 80, { sequenceJson: ["Sequence JSON", SAMMIVars.box_newline, '{"action":"sequence.run","steps":[]}', 1] });
  }
  function clearReconnectTimer() { if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; } }
  function scheduleReconnect() { if (!reconnectTimer) reconnectTimer = setTimeout(function () { reconnectTimer = null; connect(); }, 3000); }
  function flushPendingMessages() { while (socket && socket.readyState === WebSocket.OPEN && pendingMessages.length) socket.send(pendingMessages.shift()); }
  function connect() {
    clearReconnectTimer(); if (socket && (socket.readyState === WebSocket.OPEN || socket.readyState === WebSocket.CONNECTING)) return;
    setStatus("Connecting…", "#f0ad4e");
    try { socket = new WebSocket(endpoint); } catch (error) { socket = null; setStatus("Connection failed", "#ff5c70"); setResponse(String(error)); scheduleReconnect(); return; }
    socket.onopen = function () { setStatus("Connected — verifying…", "#f0ad4e"); setResponse("Verifying Avatar Suite…"); flushPendingMessages(); send({ action: "client.hello", client: "SAMMI", clientVersion: "0.3.1" }, false); };
    socket.onmessage = function (event) {
      var raw = String(event.data), message; setDiagnostics(raw); try { message = JSON.parse(raw); } catch (error) { setResponse("Avatar Suite returned an unreadable response."); return; }
      if (!message.ok) { setResponse(message.error || "Avatar Suite could not complete the command."); return; }
      if (message.action === "client.hello") { setStatus("Connected and verified", "#2ecc71"); setResponse("Connection verified. Loading catalogue…"); send({ action: "catalog.get" }, false); }
      else if (message.action === "catalog.get" && message.ok && message.catalog) {
        catalogue = message.catalog; catalogue.presets = catalogue.presets || []; catalogue.layers = catalogue.layers || []; catalogue.groups = catalogue.groups || []; catalogue.effects = catalogue.effects || []; catalogue.savedActions = catalogue.savedActions || [];
        setCatalogueSummary(); setResponse("Catalogue refreshed successfully."); registerCommands();
      } else if (message.action === "preset.activate") { setResponse("Preset activated successfully. Refreshing catalogue…"); send({ action: "catalog.get" }, false); }
      else if (message.action === "sequence.run") { setResponse("Action completed successfully. Refreshing catalogue…"); send({ action: "catalog.get" }, false); }
      else if (message.action === "server.status") setResponse("Avatar Suite is responding normally.");
    };
    socket.onerror = function () { setStatus("Connection error", "#ff5c70"); };
    socket.onclose = function () { socket = null; setStatus("Disconnected — retrying", "#ff5c70"); scheduleReconnect(); };
  }
  function reconnect() { clearReconnectTimer(); if (socket) { socket.onclose = null; socket.close(); socket = null; } connect(); }
  function send(command, queueWhenDisconnected) {
    var message = typeof command === "string" ? command : JSON.stringify(command);
    if (socket && socket.readyState === WebSocket.OPEN) { socket.send(message); return true; }
    if (queueWhenDisconnected !== false) { pendingMessages.push(message); if (pendingMessages.length > 32) pendingMessages.shift(); }
    setStatus("Waiting for Avatar Suite…", "#f0ad4e"); connect(); return false;
  }
  function checkServer() { send({ action: "server.status" }); }
  function refreshCatalogue() { send({ action: "catalog.get" }); }
  function resolve(kind, label) { var item = labels[kind] && labels[kind][String(label || "")]; if (!item) setResponse("That selection is no longer available. Refresh the command after the catalogue updates."); return item; }
  function activatePreset(label) { var item = resolve("presets", label); if (item) send({ action: "preset.activate", presetId: item.id }); }
  function setVisibility(action, label, state) { var kind = action === "layer.visibility" ? "layers" : "groups", item = resolve(kind, label); if (item) send({ action: "sequence.run", steps: [{ action: action, targetId: item.id, enabled: String(state) === "Show" }] }); }
  function setEffectState(label, state) { var item = resolve("effects", label); if (item) send({ action: "sequence.run", steps: [{ action: "effect.enabled", targetId: item.ownerId, effectId: item.id, enabled: String(state) === "Enable" }] }); }
  function runSequenceJson(sequenceJson) {
    var command; try { command = JSON.parse(String(sequenceJson || "")); } catch (error) { setResponse("Sequence JSON is invalid: " + error.message); return; }
    if (!command || command.action !== "sequence.run" || !Array.isArray(command.steps)) { setResponse('Sequence JSON must contain action "sequence.run" and a steps array.'); return; }
    send(command);
  }
  function bindControls() {
    var reconnectButton = element("rearsilver-avatar-suite-reconnect"), refreshButton = element("rearsilver-avatar-suite-refresh"), checkButton = element("rearsilver-avatar-suite-check");
    if (reconnectButton) reconnectButton.addEventListener("click", reconnect); if (refreshButton) refreshButton.addEventListener("click", refreshCatalogue); if (checkButton) checkButton.addEventListener("click", checkServer);
  }
  function start() { bindControls(); registerCommands(); connect(); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start); else start();
  return { registerCommands: registerCommands, connect: connect, reconnect: reconnect, checkServer: checkServer, refreshCatalogue: refreshCatalogue, activatePreset: activatePreset, setVisibility: setVisibility, setEffectState: setEffectState, runSequenceJson: runSequenceJson };
})();
[insert_over]
